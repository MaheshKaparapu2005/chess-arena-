# MongoDB Connection URI (optional: falls back to built-in JSON persistence store)
MONGO_URI="mongodb://localhost:27017/chess-arena"

# JWT Secret Key for user authentication tokens
JWT_SECRET="chess_arena_jwt_super_secret_key_change_in_production"

# Server Port
PORT=3000

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
